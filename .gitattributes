# Normalize line endings; let git manage them based on core.autocrlf
* text=auto

# Source files always use LF in the repo regardless of OS
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.sln      text eol=crlf
*.xaml     text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.editorconfig text eol=lf

# Binary assets — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.mp3  binary
*.wav  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.dll  binary
*.exe  binary
*.pdb  binary
*.so   binary
*.dylib binary
