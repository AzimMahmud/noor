<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ==================== LIGHT THEME ==================== -->
        <ResourceDictionary x:Key="Light">
            <!-- Page & Surface -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F4F0" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#F0EDE8" />
            <SolidColorBrush x:Key="DividerBrush" Color="#DDD9D0" />

            <!-- Primary Teal (bold, high-contrast) -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#0E7C72" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#086259" />
            <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="#C6EAE5" />

            <!-- Accent -->
            <SolidColorBrush x:Key="AccentBrush" Color="#1A9E96" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#5DC5B8" />

            <!-- Text (high contrast on light bg) -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />

            <!-- Prayer Colors — vivid, high contrast on white -->
            <SolidColorBrush x:Key="FajrBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="FajrLightBrush" Color="#DBEAFE" />
            <SolidColorBrush x:Key="DhuhrBrush" Color="#D97706" />
            <SolidColorBrush x:Key="DhuhrLightBrush" Color="#FEF3C7" />
            <SolidColorBrush x:Key="AsrBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="AsrLightBrush" Color="#FEE2E2" />
            <SolidColorBrush x:Key="MaghribBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="MaghribLightBrush" Color="#EDE9FE" />
            <SolidColorBrush x:Key="IshaBrush" Color="#4338CA" />
            <SolidColorBrush x:Key="IshaLightBrush" Color="#E0E7FF" />
            <SolidColorBrush x:Key="SunriseBrush" Color="#CA8A04" />
            <SolidColorBrush x:Key="SunriseLightBrush" Color="#FEF9C3" />

            <!-- Status -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />

            <!-- Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#40000000" />

            <!-- Glass Effect -->
            <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1A000000" />
        </ResourceDictionary>

        <!-- ==================== DARK THEME ==================== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Page & Surface (warm dark tones) -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#121218" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C1C26" />
            <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#262633" />
            <SolidColorBrush x:Key="DividerBrush" Color="#333340" />

            <!-- Primary Teal (softened for dark bg) -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#3DD8CA" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#6EEADE" />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1A9E96" />
            <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="#1A2E2C" />

            <!-- Accent -->
            <SolidColorBrush x:Key="AccentBrush" Color="#6DD5CA" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#A3E8DF" />

            <!-- Text -->
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EEEDF0" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9D9DAE" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6A6A7A" />
            <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#121218" />
            <SolidColorBrush x:Key="OnAccentTextBrush" Color="#121218" />

            <!-- Prayer Colors — muted for dark, distinct per time -->
            <SolidColorBrush x:Key="FajrBrush" Color="#7FAADC" />
            <SolidColorBrush x:Key="FajrLightBrush" Color="#1E2A3D" />
            <SolidColorBrush x:Key="DhuhrBrush" Color="#E4B462" />
            <SolidColorBrush x:Key="DhuhrLightBrush" Color="#2E2618" />
            <SolidColorBrush x:Key="AsrBrush" Color="#E09060" />
            <SolidColorBrush x:Key="AsrLightBrush" Color="#2E221A" />
            <SolidColorBrush x:Key="MaghribBrush" Color="#B88AC8" />
            <SolidColorBrush x:Key="MaghribLightBrush" Color="#261E2E" />
            <SolidColorBrush x:Key="IshaBrush" Color="#7B88B8" />
            <SolidColorBrush x:Key="IshaLightBrush" Color="#1E2030" />
            <SolidColorBrush x:Key="SunriseBrush" Color="#DEAA52" />
            <SolidColorBrush x:Key="SunriseLightBrush" Color="#2A2418" />

            <!-- Status -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#5CB87A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E4B462" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E07070" />

            <!-- Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />

            <!-- Glass Effect -->
            <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1AFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== GRADIENT BRUSHES ==================== -->
    <!-- Header gradient (warm teal) -->
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E7C72" Offset="0" />
        <GradientStop Color="#1A9E96" Offset="0.5" />
        <GradientStop Color="#5DC5B8" Offset="1" />
    </LinearGradientBrush>

    <!-- Countdown gradient -->
    <LinearGradientBrush x:Key="CountdownGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#086259" Offset="0" />
        <GradientStop Color="#0E7C72" Offset="0.4" />
        <GradientStop Color="#1A9E96" Offset="0.7" />
        <GradientStop Color="#5DC5B8" Offset="1" />
    </LinearGradientBrush>

    <!-- Next prayer badge gradient -->
    <LinearGradientBrush x:Key="NextBadgeGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A9E96" Offset="0" />
        <GradientStop Color="#5DC5B8" Offset="1" />
    </LinearGradientBrush>

    <!-- Prayer card icon gradients (vivid on light bg) -->
    <LinearGradientBrush x:Key="FajrGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DhuhrGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0" />
        <GradientStop Color="#B45309" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AsrGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0" />
        <GradientStop Color="#B91C1C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MaghribGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IshaGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4338CA" Offset="0" />
        <GradientStop Color="#3730A3" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunriseGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CA8A04" Offset="0" />
        <GradientStop Color="#A16207" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
