<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== CARD STYLES ==================== -->
    <!-- Standard card border -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    </Style>

    <!-- Prayer card with left accent bar -->
    <Style x:Key="PrayerCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    </Style>

    <!-- Location card -->
    <Style x:Key="LocationCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    </Style>

    <!-- Hero/countdown card -->
    <Style x:Key="HeroCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="32" />
    </Style>

    <!-- ==================== BUTTON STYLES ==================== -->
    <!-- Primary action button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnPrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Circular icon button -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Detect location button -->
    <Style x:Key="DetectLocationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnPrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Save button -->
    <Style x:Key="SaveButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnPrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Back button -->
    <Style x:Key="BackButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ==================== TEXTBOX STYLES ==================== -->
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ==================== COMBOBOX STYLES ==================== -->
    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundSecondaryBrush}" />
    </Style>

    <!-- ==================== DIVIDER ==================== -->
    <!-- Geometric pattern divider -->
    <Style x:Key="GeometricDivider" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0.15" />
        <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    </Style>

    <!-- Simple thin divider -->
    <Style x:Key="ThinDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
    </Style>

    <!-- ==================== ACCENT BAR ==================== -->
    <!-- Left accent bar for prayer cards -->
    <Style x:Key="AccentBar" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- ==================== TOGGLE SWITCH ==================== -->
    <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- ==================== SLIDER ==================== -->
    <Style x:Key="SettingsSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
