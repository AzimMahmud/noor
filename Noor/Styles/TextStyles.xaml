<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== PAGE HEADER ==================== -->
    <!-- Main greeting text (e.g., "Good Morning") -->
    <Style x:Key="GreetingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Date/time subtitle under greeting -->
    <Style x:Key="DateTimeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- Hijri date display (prominent) -->
    <Style x:Key="HijriDateTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    </Style>

    <!-- ==================== SECTION HEADERS ==================== -->
    <!-- Section title (e.g., "Today's Prayer Times") -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Section subtitle -->
    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- ==================== PRAYER CARD TEXT ==================== -->
    <!-- Prayer name (e.g., "Fajr") -->
    <Style x:Key="PrayerNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Prayer subtitle (e.g., "Dawn Prayer") -->
    <Style x:Key="PrayerSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- Arabic prayer name -->
    <Style x:Key="ArabicNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- Prayer time display (e.g., "05:12") -->
    <Style x:Key="PrayerTimeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Sunrise time (smaller, muted) -->
    <Style x:Key="SunriseTimeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SunriseBrush}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- ==================== HERO / COUNTDOWN ==================== -->
    <!-- "Next Prayer" label -->
    <Style x:Key="CountdownLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Next prayer name in hero -->
    <Style x:Key="NextPrayerNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Arabic name in hero -->
    <Style x:Key="NextPrayerArabicStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Countdown time (HH:MM:SS) -->
    <Style x:Key="CountdownTimeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- "Time Remaining" label -->
    <Style x:Key="TimeRemainingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <!-- ==================== BADGES ==================== -->
    <!-- "NEXT PRAYER" badge text -->
    <Style x:Key="NextBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <!-- ==================== BUTTONS ==================== -->
    <!-- Icon button text -->
    <Style x:Key="IconButtonTextStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- ==================== CAPTIONS & LABELS ==================== -->
    <!-- Small caption text -->
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
    </Style>

    <!-- Location label text -->
    <Style x:Key="LocationLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!-- Location value text -->
    <Style x:Key="LocationValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- ==================== SETTINGS PAGE ==================== -->
    <!-- Settings page title -->
    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Settings page subtitle -->
    <Style x:Key="SettingsSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- Settings section title -->
    <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Settings field label -->
    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <!-- Settings toggle title -->
    <Style x:Key="SettingsToggleTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    </Style>

    <!-- Settings toggle description -->
    <Style x:Key="SettingsToggleDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
    </Style>

    <!-- ==================== LOADING ==================== -->
    <Style x:Key="LoadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

</ResourceDictionary>
