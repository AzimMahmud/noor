<Application x:Class="Noor.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

        <!-- Custom theme colors (Light/Dark) -->
        <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />

        <!-- Typography styles -->
        <ResourceDictionary Source="ms-appx:///Styles/TextStyles.xaml" />

        <!-- Control styles and shadows -->
        <ResourceDictionary Source="ms-appx:///Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </Application.Resources>

</Application>
