<Page x:Class="Noor.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Noor.Views"
      xmlns:models="using:Noor.Models"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- DECORATIVE HEADER GRADIENT (behind content) -->
                <Border Margin="-24,-24,-24,0" HorizontalAlignment="Stretch"
                        IsHitTestVisible="False" VerticalAlignment="Top"
                        Height="200" Background="{StaticResource HeaderGradientBrush}">
                    <Image Source="ms-appx:///Assets/Svg/geometric-pattern.svg"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Stretch="UniformToFill" Opacity="0.12"/>
                </Border>

                <!-- SCROLLABLE CONTENT -->
                <StackPanel Spacing="0" Padding="24,0,24,24">

                    <!-- HEADER SECTION -->
                    <Grid Margin="0,48,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Name="GreetingText" Text="Good Morning"
                                       Style="{StaticResource GreetingTextStyle}"
                                       Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="HijriDateText" Text=""
                                           Style="{StaticResource HijriDateTextStyle}"
                                           Foreground="White" Opacity="0.85" Margin="0,2,0,0"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="CalendarButton" Click="OnCalendarClick"
                                        Background="#33FFFFFF" BorderBrush="#33FFFFFF"
                                        Width="30" Height="30" CornerRadius="15"
                                        Padding="0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="White"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="CurrentTimeText" Text=""
                                       Style="{StaticResource DateTimeTextStyle}"
                                       Foreground="White" Opacity="0.7"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10" Orientation="Horizontal">
                            <Button x:Name="RefreshButton" Click="OnRefreshClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#33FFFFFF" BorderBrush="#33FFFFFF">
                                <FontIcon x:Name="RefreshIcon" Glyph="&#xE117;"
                                          FontSize="18" Foreground="White"/>
                            </Button>
                            <Button x:Name="SettingsButton" Click="OnSettingsClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#33FFFFFF" BorderBrush="#33FFFFFF">
                                <FontIcon Glyph="&#xE713;" FontSize="18"
                                          Foreground="White"/>
                            </Button>
                            <Button x:Name="ThemeToggleButton" Click="OnThemeToggleClick"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#33FFFFFF" BorderBrush="#33FFFFFF">
                                <FontIcon x:Name="ThemeIcon" Glyph="&#xE771;"
                                          FontSize="18" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- LOCATION CARD -->
                    <Border x:Name="LocationCard" Style="{StaticResource LocationCardBorder}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="CURRENT LOCATION" Style="{StaticResource LocationLabelStyle}"/>
                                <TextBlock x:Name="LocationText" Text="Detecting..."
                                           Style="{StaticResource LocationValueStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14"
                                    Background="{ThemeResource PrimarySurfaceBrush}">
                                <FontIcon Glyph="&#xE909;" FontSize="24"
                                          Foreground="{ThemeResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- NEXT PRAYER HERO -->
                    <Border x:Name="HeroCard" Margin="0,0,0,24"
                            CornerRadius="24" Padding="32,28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0E7C72" Offset="0"/>
                                <GradientStop Color="#086259" Offset="0.6"/>
                                <GradientStop Color="#064E48" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image Source="ms-appx:///Assets/Svg/geometric-pattern.svg"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Width="200" Height="200" Stretch="UniformToFill"
                                   Opacity="0.08" Margin="0,-40,-20,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="UPCOMING PRAYER"
                                               Style="{StaticResource CountdownLabelStyle}"
                                               CharacterSpacing="100"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="NextPrayerNameText" Text="Loading..."
                                                   Style="{StaticResource NextPrayerNameStyle}"/>
                                        <TextBlock x:Name="NextPrayerArabicText" Text=""
                                                   Style="{StaticResource NextPrayerArabicStyle}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HijriDateHeroText" Text=""
                                               Foreground="White" FontSize="13" Opacity="0.65"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="TIME REMAINING"
                                               Style="{StaticResource TimeRemainingStyle}"
                                               TextAlignment="Right"/>
                                    <TextBlock x:Name="CountdownText" Text="--:--:--"
                                               Style="{StaticResource CountdownTimeStyle}"
                                               TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- SECTION HEADER -->
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Height="28" CornerRadius="2"
                                Margin="0,0,14,0" Background="{ThemeResource PrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Today's Prayer Times"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- PRAYER CARDS -->
                    <StackPanel x:Name="PrayerList" Spacing="12">

                        <!-- FAJR -->
                        <Border x:Name="FajrCard" Style="{StaticResource PrayerCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AccentBar}"
                                        Background="{ThemeResource FajrBrush}" Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                        Background="{StaticResource FajrGradientBrush}">
                                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Fajr" Style="{StaticResource PrayerNameStyle}"/>
                                    <TextBlock Text="Dawn Prayer" Style="{StaticResource PrayerSubtitleStyle}"/>
                                    <TextBlock Text="&#x627;&#x644;&#x641;&#x62C;&#x631;" Style="{StaticResource ArabicNameStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="FajrTime" Text="--:--"
                                               Style="{StaticResource PrayerTimeStyle}"
                                               Foreground="{ThemeResource FajrBrush}"/>
                                    <Border x:Name="FajrNextBadge" CornerRadius="12" Padding="12,5"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Background="{StaticResource NextBadgeGradientBrush}">
                                        <TextBlock Text="NEXT" Style="{StaticResource NextBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SUNRISE -->
                        <Border Style="{StaticResource PrayerCardBorder}" Opacity="0.6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" Height="44" CornerRadius="2"
                                        Margin="0,0,16,0" Background="{ThemeResource SunriseBrush}" Opacity="0.5"/>
                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Margin="0,0,16,0"
                                        Background="{ThemeResource SunriseLightBrush}">
                                    <FontIcon Glyph="&#xE706;" FontSize="22"
                                              Foreground="{ThemeResource SunriseBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Sunrise" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}" Opacity="0.7"/>
                                    <TextBlock Text="Not a prayer time" FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" x:Name="SunriseTime" Text="--:--"
                                           Style="{StaticResource SunriseTimeStyle}"/>
                            </Grid>
                        </Border>

                        <!-- DHUHR -->
                        <Border x:Name="DhuhrCard" Style="{StaticResource PrayerCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AccentBar}"
                                        Background="{ThemeResource DhuhrBrush}" Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                        Background="{StaticResource DhuhrGradientBrush}">
                                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Dhuhr" Style="{StaticResource PrayerNameStyle}"/>
                                    <TextBlock Text="Noon Prayer" Style="{StaticResource PrayerSubtitleStyle}"/>
                                    <TextBlock Text="&#x627;&#x644;&#x638;&#x647;&#x631;" Style="{StaticResource ArabicNameStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="DhuhrTime" Text="--:--"
                                               Style="{StaticResource PrayerTimeStyle}"
                                               Foreground="{ThemeResource DhuhrBrush}"/>
                                    <Border x:Name="DhuhrNextBadge" CornerRadius="12" Padding="12,5"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Background="{StaticResource NextBadgeGradientBrush}">
                                        <TextBlock Text="NEXT" Style="{StaticResource NextBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ASR -->
                        <Border x:Name="AsrCard" Style="{StaticResource PrayerCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AccentBar}"
                                        Background="{ThemeResource AsrBrush}" Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                        Background="{StaticResource AsrGradientBrush}">
                                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Asr" Style="{StaticResource PrayerNameStyle}"/>
                                    <TextBlock Text="Afternoon Prayer" Style="{StaticResource PrayerSubtitleStyle}"/>
                                    <TextBlock Text="&#x627;&#x644;&#x639;&#x635;&#x631;" Style="{StaticResource ArabicNameStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AsrTime" Text="--:--"
                                               Style="{StaticResource PrayerTimeStyle}"
                                               Foreground="{ThemeResource AsrBrush}"/>
                                    <Border x:Name="AsrNextBadge" CornerRadius="12" Padding="12,5"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Background="{StaticResource NextBadgeGradientBrush}">
                                        <TextBlock Text="NEXT" Style="{StaticResource NextBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- MAGHRIB -->
                        <Border x:Name="MaghribCard" Style="{StaticResource PrayerCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AccentBar}"
                                        Background="{ThemeResource MaghribBrush}" Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                        Background="{StaticResource MaghribGradientBrush}">
                                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Maghrib" Style="{StaticResource PrayerNameStyle}"/>
                                    <TextBlock Text="Sunset Prayer" Style="{StaticResource PrayerSubtitleStyle}"/>
                                    <TextBlock Text="&#x627;&#x644;&#x645;&#x63A;&#x631;&#x628;" Style="{StaticResource ArabicNameStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="MaghribTime" Text="--:--"
                                               Style="{StaticResource PrayerTimeStyle}"
                                               Foreground="{ThemeResource MaghribBrush}"/>
                                    <Border x:Name="MaghribNextBadge" CornerRadius="12" Padding="12,5"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Background="{StaticResource NextBadgeGradientBrush}">
                                        <TextBlock Text="NEXT" Style="{StaticResource NextBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ISHA -->
                        <Border x:Name="IshaCard" Style="{StaticResource PrayerCardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AccentBar}"
                                        Background="{ThemeResource IshaBrush}" Margin="0,0,16,0"/>
                                <Border Grid.Column="1" Width="52" Height="52" CornerRadius="14" Margin="0,0,16,0"
                                        Background="{StaticResource IshaGradientBrush}">
                                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Isha" Style="{StaticResource PrayerNameStyle}"/>
                                    <TextBlock Text="Night Prayer" Style="{StaticResource PrayerSubtitleStyle}"/>
                                    <TextBlock Text="&#x627;&#x644;&#x639;&#x634;&#x627;&#x621;" Style="{StaticResource ArabicNameStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="IshaTime" Text="--:--"
                                               Style="{StaticResource PrayerTimeStyle}"
                                               Foreground="{ThemeResource IshaBrush}"/>
                                    <Border x:Name="IshaNextBadge" CornerRadius="12" Padding="12,5"
                                            HorizontalAlignment="Right" Visibility="Collapsed"
                                            Background="{StaticResource NextBadgeGradientBrush}">
                                        <TextBlock Text="NEXT" Style="{StaticResource NextBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <Border Height="24"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- LOADING OVERLAY -->
        <Border Grid.Row="0"
                Background="{ThemeResource OverlayBrush}"
                x:Name="LoadingOverlay" Visibility="Collapsed">
            <Grid>
                <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="LoadingRing" Width="52" Height="52" Foreground="White"/>
                    <TextBlock Text="Loading prayer times..."
                               Style="{StaticResource LoadingTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BLOCK SCREEN HOST -->
        <Grid x:Name="BlockScreenHost" Grid.Row="0"/>

    </Grid>
</Page>
