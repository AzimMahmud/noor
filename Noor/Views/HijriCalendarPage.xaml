<Page x:Class="Noor.Views.HijriCalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Disabled"
      Background="{ThemeResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Grid Grid.Row="0" Padding="20,12,20,12"
              Background="{ThemeResource CardBackgroundBrush}"
              BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackButton" Click="OnBackClick"
                    Background="Transparent" BorderThickness="0"
                    Width="36" Height="36" CornerRadius="18" Padding="0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontSize="16"
                          Foreground="{ThemeResource PrimaryTextBrush}"/>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevMonthButton" Click="OnPrevMonthClick"
                        Background="Transparent" BorderThickness="0"
                        Width="30" Height="30" CornerRadius="15" Padding="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="11"
                              Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
                <TextBlock x:Name="MonthNameArabicText" Text=""
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="MonthNameEnglishText" Text=""
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="HijriYearText" Text=""
                           FontSize="17" FontWeight="Light"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
                <Button x:Name="NextMonthButton" Click="OnNextMonthClick"
                        Background="Transparent" BorderThickness="0"
                        Width="30" Height="30" CornerRadius="15" Padding="0">
                    <FontIcon Glyph="&#xE72A;" FontSize="11"
                              Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" x:Name="TodayButton" Click="OnTodayClick"
                    Background="{ThemeResource PrimaryBrush}" CornerRadius="8"
                    Padding="14,6" FontSize="11" FontWeight="SemiBold"
                    Foreground="{ThemeResource OnPrimaryTextBrush}"
                    VerticalAlignment="Center">
                TODAY
            </Button>
        </Grid>

        <!-- ═══════ SCROLLABLE CONTENT ═══════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="0,0,0,24">
                <StackPanel Spacing="14">

                    <!-- TODAY INFO CARD -->
                    <Border x:Name="TodayInfoCard" Margin="16,12,16,0"
                            CornerRadius="16" Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0E7C72" Offset="0"/>
                                <GradientStop Color="#086259" Offset="0.6"/>
                                <GradientStop Color="#064E48" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Padding="18,14,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    CornerRadius="26" Background="#22FFFFFF"
                                    Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Spacing="0">
                                    <TextBlock x:Name="TodayDayNumber" Text=""
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TodayDayName" Text=""
                                               FontSize="8" FontWeight="SemiBold"
                                               Foreground="White" Opacity="0.7"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TodayGregorianText" Text=""
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TodayHijriFullText" Text=""
                                           FontSize="12"
                                           Foreground="White" Opacity="0.75"/>
                                <TextBlock x:Name="TodayCountdownText" Text=""
                                           FontSize="11"
                                           Foreground="White" Opacity="0.55"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MONTH STATS -->
                    <Grid Margin="16,0,16,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="12" Padding="10,8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="StatDaysText" Text="29"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{ThemeResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Days" FontSize="9"
                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="12" Padding="10,8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="StatEventsText" Text="0"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{ThemeResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Events" FontSize="9"
                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="12" Padding="10,8"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="StatRemindersText" Text="0"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{ThemeResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Reminders" FontSize="9"
                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CALENDAR -->
                    <Border CornerRadius="16" Margin="16,0,16,0"
                            Padding="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                        <StackPanel Spacing="0">
                            <Grid Padding="14,10,14,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SUN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="1" Text="MON" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="2" Text="TUE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="3" Text="WED" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="4" Text="THU" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="5" Text="FRI" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                                <TextBlock Grid.Column="6" Text="SAT" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center"
                                           CharacterSpacing="80"/>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="14,0,14,0"/>
                            <Grid x:Name="CalendarGrid" Margin="6,2,6,6"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ DATE CONVERTER ═══════ -->
                    <Border CornerRadius="16" Margin="16,0,16,0"
                            Padding="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                        <StackPanel Spacing="0">
                            <!-- Header -->
                            <Grid Padding="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0E7C72" Offset="0"/>
                                            <GradientStop Color="#1A9E96" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <FontIcon Glyph="&#xE787;" FontSize="13"
                                              Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Date Converter"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="16,0,16,0"/>

                            <!-- Gregorian input -->
                            <StackPanel Padding="16,14,16,6" Spacing="8">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                            Background="{ThemeResource PrimaryBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="GREGORIAN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TertiaryTextBrush}"
                                               CharacterSpacing="50" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Year / Month / Day selectors -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="YEAR" FontSize="8" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                   CharacterSpacing="40"/>
                                        <ComboBox x:Name="ConverterYearCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="8" Padding="8,6"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  SelectionChanged="OnConverterDateChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="MONTH" FontSize="8" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                   CharacterSpacing="40"/>
                                        <ComboBox x:Name="ConverterMonthCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="8" Padding="8,6"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  SelectionChanged="OnConverterDateChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="DAY" FontSize="8" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                   CharacterSpacing="40"/>
                                        <ComboBox x:Name="ConverterDayCombo"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="8" Padding="8,6"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  SelectionChanged="OnConverterDateChanged"/>
                                    </StackPanel>

                                    <Button Grid.Column="3" Click="OnTodayConverterClick"
                                            CornerRadius="8" Padding="10,4"
                                            FontSize="11" FontWeight="SemiBold"
                                            VerticalAlignment="Bottom"
                                            Height="32"
                                            Background="{ThemeResource PrimarySurfaceBrush}"
                                            Foreground="{ThemeResource PrimaryBrush}"
                                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                                        Today
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="GregorianDayNameText" Text=""
                                           FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"
                                           Margin="2,0,0,2"/>
                            </StackPanel>

                            <!-- Arrow divider -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,0">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{ThemeResource PrimarySurfaceBrush}"/>
                                <FontIcon Glyph="&#xE72A;" FontSize="16"
                                          Foreground="{ThemeResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Hijri result -->
                            <StackPanel Padding="16,6,16,16" Spacing="6">
                                <Grid ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                                            Background="{ThemeResource MaghribBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="HIJRI" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TertiaryTextBrush}"
                                               CharacterSpacing="50" VerticalAlignment="Center"/>
                                </Grid>

                                <Border x:Name="ConverterResultBorder" CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource CardBackgroundSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                                    <StackPanel x:Name="ConverterResultPanel" Spacing="6">
                                        <!-- English result -->
                                        <TextBlock x:Name="ConverterResultText" Text="Select a date above"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <!-- Arabic result -->
                                        <TextBlock x:Name="ConverterResultArabicText" Text=""
                                                   FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PrimaryBrush}"
                                                   FlowDirection="RightToLeft"
                                                   TextAlignment="Center"/>
                                        <!-- Day name -->
                                        <TextBlock x:Name="ConverterDayNameText" Text=""
                                                   FontSize="12"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ REMINDERS ═══════ -->
                    <Border CornerRadius="16" Margin="16,0,16,0"
                            Padding="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                        <StackPanel Spacing="0">
                            <!-- Header -->
                            <Grid Padding="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DC2626" Offset="0"/>
                                            <GradientStop Color="#E07070" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <FontIcon Glyph="&#xE707;" FontSize="13"
                                              Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Reminders"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" x:Name="AddReminderButton"
                                        Click="OnAddReminderToggleClick"
                                        CornerRadius="8" Padding="10,5"
                                        FontSize="11" FontWeight="SemiBold">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0E7C72" Offset="0"/>
                                            <GradientStop Color="#1A9E96" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Foreground>
                                        <SolidColorBrush Color="White"/>
                                    </Button.Foreground>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="AddReminderIcon" Glyph="&#xE710;" FontSize="11" Foreground="White"/>
                                        <TextBlock x:Name="AddReminderText" Text="Add" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="16,0,16,0"/>

                            <!-- Inline add form -->
                            <Border x:Name="AddReminderForm" Visibility="Collapsed"
                                    Padding="16,12,16,14"
                                    Background="{ThemeResource CardBackgroundSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="New Reminder" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>

                                    <!-- Name -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="REMINDER NAME" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                   CharacterSpacing="50"/>
                                        <TextBox x:Name="ReminderNameBox"
                                                 PlaceholderText="e.g. Laylat al-Qadr"
                                                 CornerRadius="8" Padding="10,8"
                                                 FontSize="12"/>
                                    </StackPanel>

                                    <!-- Day + Category -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="HIJRI DAY" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TertiaryTextBrush}"
                                                       CharacterSpacing="50"/>
                                            <ComboBox x:Name="ReminderDayCombo"
                                                      HorizontalAlignment="Stretch"
                                                      CornerRadius="8" Padding="8,6"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="CATEGORY" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TertiaryTextBrush}"
                                                       CharacterSpacing="50"/>
                                            <ComboBox x:Name="ReminderCategoryCombo"
                                                      HorizontalAlignment="Stretch"
                                                      CornerRadius="8" Padding="8,6"
                                                      FontSize="12">
                                                <ComboBoxItem Content="Select category..." IsEnabled="False" Tag=""/>
                                                <ComboBoxItem Content="&#x1F54C; Religious" Tag="Religious"/>
                                                <ComboBoxItem Content="&#x1F4E6; Personal" Tag="Personal"/>
                                                <ComboBoxItem Content="&#x1F3E0; Family" Tag="Family"/>
                                                <ComboBoxItem Content="&#x1F4DA; Study" Tag="Study"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Notify + Repeat -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="NOTIFY BEFORE" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TertiaryTextBrush}"
                                                       CharacterSpacing="50"/>
                                            <ComboBox x:Name="ReminderNotifyCombo"
                                                      HorizontalAlignment="Stretch"
                                                      CornerRadius="8" Padding="8,6"
                                                      FontSize="12">
                                                <ComboBoxItem Content="Select time..." IsEnabled="False" Tag=""/>
                                                <ComboBoxItem Content="Same day" Tag="0"/>
                                                <ComboBoxItem Content="1 day before" Tag="1"/>
                                                <ComboBoxItem Content="3 days before" Tag="3"/>
                                                <ComboBoxItem Content="7 days before" Tag="7"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3" MinWidth="110">
                                            <TextBlock Text="REPEAT" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TertiaryTextBrush}"
                                                       CharacterSpacing="50"/>
                                            <ComboBox x:Name="ReminderRepeatCombo"
                                                      HorizontalAlignment="Stretch"
                                                      CornerRadius="8" Padding="8,6"
                                                      FontSize="12">
                                                <ComboBoxItem Content="Select repeat..." IsEnabled="False" Tag=""/>
                                                <ComboBoxItem Content="Never" Tag="None"/>
                                                <ComboBoxItem Content="Every year" Tag="Yearly"/>
                                                <ComboBoxItem Content="Every month" Tag="Monthly"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Buttons -->
                                    <Grid ColumnSpacing="6" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Cancel"
                                                Click="OnCancelReminderClick"
                                                CornerRadius="8" Padding="14,8"
                                                FontSize="12" FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="{ThemeResource CardBackgroundSecondaryBrush}"
                                                Foreground="{ThemeResource SecondaryTextBrush}"
                                                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"/>
                                        <Button Grid.Column="1" Click="OnSaveReminderClick"
                                                CornerRadius="8" Padding="18,8"
                                                FontSize="12" FontWeight="SemiBold"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0E7C72" Offset="0"/>
                                                    <GradientStop Color="#1A9E96" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Foreground>
                                                <SolidColorBrush Color="White"/>
                                            </Button.Foreground>
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE74E;" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Reminder list -->
                            <StackPanel x:Name="RemindersList" Spacing="0" Margin="0,0,0,2"/>

                            <!-- Empty state -->
                            <StackPanel x:Name="RemindersEmpty" Spacing="0"
                                        HorizontalAlignment="Center" Margin="0,20,0,20"
                                        Visibility="Visible">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FEE2E2" Offset="0"/>
                                            <GradientStop Color="#FECACA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <FontIcon Glyph="&#xE707;" FontSize="20"
                                              Foreground="{ThemeResource ErrorBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No reminders yet"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Track important Hijri dates"
                                           FontSize="11"
                                           Foreground="{ThemeResource TertiaryTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══════ EVENTS ═══════ -->
                    <Border x:Name="EventsCard" CornerRadius="16" Margin="16,0,16,0"
                            Padding="0"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Spacing="0">
                            <Grid Padding="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0E7C72" Offset="0"/>
                                            <GradientStop Color="#1A9E96" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <FontIcon Glyph="&#xE787;" FontSize="13"
                                              Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Islamic Events"
                                           FontSize="14" FontWeight="SemiBold"
