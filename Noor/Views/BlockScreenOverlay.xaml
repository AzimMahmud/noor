<UserControl x:Class="Noor.Views.BlockScreenOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="Collapsed">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Color="#062620" Offset="0"/>
                <GradientStop Color="#0A3D35" Offset="0.4"/>
                <GradientStop Color="#0A4A42" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP DECORATION -->
        <Image Grid.Row="0"
               Source="ms-appx:///Assets/Svg/geometric-pattern.svg"
               HorizontalAlignment="Center" VerticalAlignment="Bottom"
               Width="300" Height="80" Stretch="UniformToFill"
               Opacity="0.1" Margin="0,0,0,20"/>

        <!-- CENTER CONTENT -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="16">
            <!-- Mosque Icon -->
            <Image Source="ms-appx:///Assets/Svg/mosque.svg"
                   Width="120" Height="120" Stretch="Uniform"
                   HorizontalAlignment="Center" Opacity="0.9"/>

            <!-- Prayer Name -->
            <TextBlock x:Name="PrayerNameText"
                       Text="Prayer Time"
                       FontSize="36" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       CharacterSpacing="50"/>

            <!-- Arabic Name -->
            <TextBlock x:Name="PrayerArabicText"
                       Text=""
                       FontSize="28"
                       Foreground="White" Opacity="0.7"
                       HorizontalAlignment="Center"
                       FontFamily="Arial"/>

            <!-- Message -->
            <TextBlock Text="It's time to pray"
                       FontSize="18"
                       Foreground="White" Opacity="0.6"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <!-- Countdown -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="8" Margin="0,16,0,0">
                <TextBlock Text="Auto-dismiss in"
                           FontSize="14" Foreground="White" Opacity="0.5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="CountdownText"
                           Text="20:00"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- BOTTOM BUTTON -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,20,0,40">
            <Button x:Name="DismissButton"
                    Click="OnDismissClick"
                    HorizontalAlignment="Center"
                    Padding="40,14"
                    CornerRadius="24"
                    FontSize="16" FontWeight="SemiBold"
                    Background="#33FFFFFF"
                    Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="White"/>
                    <TextBlock Text="Dismiss" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- BOTTOM DECORATION -->
        <Image Grid.Row="2"
               Source="ms-appx:///Assets/Svg/crescent.svg"
               Width="60" Height="60" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Opacity="0.15" Margin="0,0,40,40"/>
    </Grid>
</UserControl>
